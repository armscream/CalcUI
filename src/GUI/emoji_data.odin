emoji_group_count :: proc() -> int {
	return len(emoji_group_names)
}

//* The name of a group, empty when there is no such group.
emoji_group_name :: proc(g: ^GUI, index: int) -> string {
	if index < 0 || index >= len(emoji_group_names) { return "" }
	return emoji_group_names[index]
}

//* The emoji of a group. The slice is a piece of the table, so it must not be freed.
emoji_in_group :: proc(g: ^GUI, index: int) -> []Emoji_Entry {
	if index < 0 || index >= len(emoji_group_names) { return nil }
	first := -1
	last := -1
	for item, i in EMOJI_SOURCE {
		if item.group != index { continue }
		if first < 0 { first = i }
		last = i
	}
	if first < 0 { return nil }
	return EMOJI_SOURCE[first:last+1]
}

//* The character of an emoji, by its name. The string is empty when
//* there is no emoji of that name.
emoji_by_name :: proc(g: ^GUI, name: string) -> string {
	for item in EMOJI_SOURCE {
		if item.name == name { return item.emoji }
	}
	return ""
}
