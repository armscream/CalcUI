EMOJI_SOURCE: []Core.Emoji_Entry = Core.EMOJI_SOURCE

Frame :: proc(g: ^GUI) {
	if g == nil {return}
	Core.Frame_Begin(g)
	virt.arena_free_all(&g.frame_arena)
	g.dt = Core.frame_time(g)
	Core.caret_tick(g)
	Core.widget_update_pass(g)
	Animation.Animation_Update(g, g.dt)
	Core.layout_pass(g)
	Widgets.menu_buttons_reposition(g)
	Core.update_resize_hover(g)
	Core.widget_post_update_pass(g)
	if Core.draw_needs_rebuild(g) {
		Core.build_draw_list(g)
	}
	Core.atlas_flush(g.atlas, g.backend, g.atlas_texture)
	Core.atlas_next_frame(g.atlas)
	Core.report_atlas_failures(g)
}

Init_GUI :: proc(width, height: i32, backend: Backend) -> ^GUI {
	g := Core.Init_GUI(width, height, backend)
	if g != nil { Widgets.gui_make_tooltip(g) }
	return g
}

Init_GUI_Checked :: proc(width, height: i32, backend: Backend) -> (^GUI, Error) {
	g, err := Core.Init_GUI_Checked(width, height, backend)
	if g != nil { Widgets.gui_make_tooltip(g) }
	return g, err
}

Init_GUI_With_Atlas :: proc(width, height: i32, backend: Backend, atlas_size: int) -> ^GUI {
	g := Core.Init_GUI_With_Atlas(width, height, backend, atlas_size)
	if g != nil { Widgets.gui_make_tooltip(g) }
	return g
}

Init_GUI_With_Atlas_Checked :: proc(width, height: i32, backend: Backend, atlas_size: int) -> (^GUI, Error) {
	g, err := Core.Init_GUI_With_Atlas_Checked(width, height, backend, atlas_size)
	if g != nil { Widgets.gui_make_tooltip(g) }
	return g, err
}

New_Widget :: proc(g: ^GUI, type: Widget_Type, parent: Widget_ID, opts: Widget_Opts = {}) -> Widget_ID {
	if type == .Button { Widgets.button_kind_register(g) }
	return Core.New_Widget(g, type, parent, opts)
}

Load_UI :: proc(path: string, g: ^GUI) -> Widget_ID {
	if g == nil { return INVALID_WIDGET_ID }
	allocator := virt.arena_allocator(&g.arena)
	data, err := os.read_entire_file_from_path(path, allocator)
	if err != nil {
		log.errorf("the scene %q could not be read: %v", path, err)
		return INVALID_WIDGET_ID
	}
	return Widgets.Scene_Load(g, string(data))
}
